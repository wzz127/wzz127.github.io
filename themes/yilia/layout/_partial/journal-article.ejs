<div class="reader-wrap">
<a href="<%= url_for('/') %>" class="reader-back">← 返回文章列表</a>
<article>
<header class="reader-top">
<div class="post-meta">
<% post.categories && post.categories.each(function(c){ %>
<a class="category-pill" href="<%= url_for(c.path) %>">
<%= c.name %>
</a>
<% }) %>
<% post.tags && post.tags.each(function(t){ %>
<a href="<%= url_for(t.path) %>"># <%= t.name %>
</a>
<% }) %>
</div>
<h1 class="reader-title article-title">
<%= post.title %>
</h1>
<div class="reader-info">
<span class="reader-author">k-fad <span class="muted">/ <%= config.author %>
</span>
</span>
<time datetime="<%= date_xml(post.date) %>">
<%= date(post.date,'YYYY.MM.DD') %>
</time>
</div>
<%- partial('post/stats',{post:post}) %>
</header>
<% if(theme.toc === 2 || (theme.toc === 1 && post.toc)) { %>
<details class="mobile-toc"><summary>文章目录</summary><nav aria-label="手机文章目录"><%- toc(post.content) %></nav></details>
<% } %>
<div class="reader-layout">
<div class="prose article-entry" itemprop="articleBody">
<%- post.content %>
</div>
<% if(theme.toc === 2 || (theme.toc === 1 && post.toc)) { %>
<nav class="reader-toc" aria-label="文章目录">
<h2>这篇文章里</h2>
<%- toc(post.content) %>
</nav>
<% } %>
</div>
</article>
<%- partial('post/nav',{post:post}) %>
<% if(post.comments !== false && theme.giscus && theme.giscus.enable) { %>
<%- partial('post/giscus') %>
<% } %>
</div>