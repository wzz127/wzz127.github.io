<footer id="footer">
  <div class="outer">
    <div id="footer-info">
      <div class="footer-left">
        &copy; <%= date(new Date(), 'YYYY') %> <%= config.author || config.title %>
      </div>
      <div class="footer-right">
        <a href="https://hexo.io/" target="_blank" rel="noopener noreferrer">Hexo</a>  Theme <a href="https://github.com/litten/hexo-theme-yilia" target="_blank" rel="noopener noreferrer">Yilia</a> by Litten
        </div>
    </div>
    <% if (theme.busuanzi){ %>
    <div id="footer-busuanzi" style="text-align:center;color:#999;font-size:12px;margin-top:8px;">
      <span id="busuanzi_container_site_pv" style="display:none">本站总访问量 <span id="busuanzi_value_site_pv"></span> 次</span>
      <span id="busuanzi_container_site_uv" style="display:none">&nbsp;·&nbsp;访客数 <span id="busuanzi_value_site_uv"></span> 人</span>
    </div>
    <% } %>
  </div>
</footer>
