<% var defaultBg = '#4d4d4d'; %>
<div class="overlay" style="background: <%= theme.style && theme.style.header ? theme.style.header : defaultBg %>"></div>
<div class="intrude-less">
  <header id="header" class="inner">
    <a href="<%= url_for('/') %>" class="profilepic">
      <img src="<%= url_for(theme.avatar) %>" alt="<%= config.author %>" width="128" height="128" class="js-avatar show">
    </a>
    <hgroup>
      <h1 class="header-author"><a href="<%= url_for('/') %>"><%= config.author %></a></h1>
    </hgroup>
    <% if (config.subtitle){ %>
    <p class="header-subtitle"><%= config.subtitle %></p>
    <%}%>

    <%
      var menuPages = [], menuCats = [];
      var catPrefix = '/' + (config.category_dir || 'categories') + '/';
      var catColorMap = { 'sanxing': '#a0cfe4', 'work-notes': '#c4a574', 'daily-life': '#9cbf9e', 'hadoop': '#b0a7c9' };
      var catPalette = ['#a0cfe4', '#c4a574', '#9cbf9e', '#b0a7c9', '#d4a0a0', '#8fb8c9'];
      for (var menuName in theme.menu) {
        var menuUrl = theme.menu[menuName];
        var matched = null;
        if (menuUrl.indexOf(catPrefix) === 0) {
          var catSlug = menuUrl.slice(catPrefix.length).replace(/\/+$/, '');
          site.categories.forEach(function (c) { if (!matched && c.slug === catSlug) matched = c; });
        }
        if (matched) menuCats.push({ name: menuName, url: menuUrl, cat: matched });
        else menuPages.push({ name: menuName, url: menuUrl });
      }
    %>
    <nav class="header-menu menu-cards">
      <div class="menu-card">
        <div class="menu-card-title">浏 览</div>
        <% menuPages.forEach(function (p) { %>
          <a class="menu-row<%= p.url === '/' ? (is_home() ? ' active' : '') : (is_current(p.url) ? ' active' : '') %>" href="<%- url_for(p.url) %>"><%= p.name %></a>
        <% }) %>
      </div>
      <div class="menu-card">
        <div class="menu-card-title">文 章 分 类</div>
        <% menuCats.forEach(function (m, i) { %>
          <a class="menu-row<%= is_category(m.cat.name) ? ' active' : '' %>" href="<%- url_for(m.url) %>"><span class="menu-dot" style="background: <%= catColorMap[m.cat.slug] || catPalette[i % catPalette.length] %>"></span><%= m.name %><span class="menu-count"><%= m.cat.posts.length %></span></a>
        <% }) %>
      </div>
    </nav>
    <nav class="header-smart-menu">
        <% for (var i in theme.smart_menu){ %>
          <% if(theme.smart_menu[i]){ %>
          <a q-on="click: openSlider(e, '<%-i%>')" href="javascript:void(0)"><%= theme.smart_menu[i] %></a>
          <% } %>
            <%}%>
    </nav>
    <nav class="header-nav">
      <div class="social">
        <% for (var i in theme.subnav){ %>
          <a class="<%= i %>" target="_blank" href="<%- url_for(theme.subnav[i]) %>" title="<%= i %>"><i class="icon-<%= i %>"></i></a>
            <%}%>
      </div>
    </nav>
  </header>
</div>
