<div class="giscus-ctn">
  <div class="giscus"></div>
</div>
<script src="https://giscus.app/client.js"
  data-repo="<%= theme.giscus.repo %>"
  data-repo-id="<%= theme.giscus['repo-id'] %>"
  data-category="<%= theme.giscus.category %>"
  data-category-id="<%= theme.giscus['category-id'] %>"
  data-mapping="<%= theme.giscus.mapping || 'pathname' %>"
  data-strict="1"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="<%= theme.giscus.theme || 'light' %>"
  data-lang="zh-CN"
  data-loading="lazy"
  crossorigin="anonymous"
  async></script>
