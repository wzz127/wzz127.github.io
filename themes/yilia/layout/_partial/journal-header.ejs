<span class="brand-caption">一个人的记录</span>
</a>
<nav class="main-nav" aria-label="主导航">
<a href="<%= url_for('/') %>" data-nav="home" <% if (is_home() || is_post() || is_category() || is_tag()) { %>aria-current="page"<% } %> >文章</a>
