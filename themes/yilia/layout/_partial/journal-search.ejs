<dialog id="search-dialog" aria-label="搜索博客文章">
<form class="search-box" id="search-form">
<svg aria-hidden="true">
<use href="#i-search"/>
</svg>
<input id="search-input" type="search" placeholder="搜索文章、话题或关键词…" aria-label="搜索关键词" autocomplete="off">
<button type="button" class="search-close" id="close-search" aria-label="关闭搜索">
<svg aria-hidden="true">
<use href="#i-close"/>
</svg>
</button>
</form>
<div class="search-results" id="search-results">
</div>
<div class="search-bottom">
<span id="search-summary" role="status">搜索博客文章</span>
<span>
<kbd class="key">ESC</kbd> 关闭</span>
</div>
</dialog>