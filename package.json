{
  "name": "wzz127-blog",
  "version": "1.0.0",
  "private": true,
  "description": "k-fad 的博客，使用 Hexo 和 Yilia 主题",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "hexo": {
    "version": "8.1.2"
  },
  "scripts": {
    "clean": "hexo clean",
    "start": "hexo server --ip 127.0.0.1",
    "new": "hexo new",
    "build": "node tooling/build.mjs",
    "build:redirects": "node tooling/build-pages-redirects.mjs",
    "check": "node tooling/check-site.mjs",
    "test": "npm run build && node --test tooling/*.test.mjs",
    "sync:comments": "node tooling/sync-comments.mjs",
    "deploy:legacy": "npm run build && hexo deploy"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-deployer-git": "4.0.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0"
  },
  "devDependencies": {
    "cheerio": "1.2.0"
  }
}
